   else:
       print(f"No se encontró ruta de {origen2} a {destino2}.")
   print("\n" + "="*50)
   # Prueba de encadenamiento hacia adelante
   print("=== PRUEBA DE ENCADENAMIENTO HACIA ADELANTE ===")
   hechos_iniciales = [("Portal Norte", "Calle 127", "B1", 8)]
   inferidos = sistema.forward_chaining(hechos_iniciales)
   print(f"Hechos iniciales: {hechos_iniciales}")
   print(f"Hechos inferidos (primeros 10):")
   for h in list(inferidos)[:10]:
       print(f"  {h}")
