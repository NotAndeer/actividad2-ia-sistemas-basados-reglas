       ruta_estaciones = [origen] + [est for est, _ in camino]
       print(f"Mejor ruta de {origen} a {destino}:")
       print(" -> ".join(ruta_estaciones))
       print(f"Tiempo total estimado: {tiempo} minutos")
       print("\nDetalle por tramos:")
       for a, b, linea, t in detalles:
           print(f"  {a} -> {b} (Línea {linea}, {t} min)")
   else:
       print(f"No se encontró ruta de {origen} a {destino}.")
   print("\n" + "="*50)
